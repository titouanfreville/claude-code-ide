<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Run moonlight" type="CargoCommandRunConfiguration" factoryName="Cargo Command">
    <option name="buildProfileId" value="dev" />
    <option name="command" value="run --package moonlight-desktop --bin moonlight" />
    <option name="workingDirectory" value="file://$PROJECT_DIR$" />
    <envs>
      <env name="RUST_LOG" value="info" />
      <!-- GPUI compiles Metal shaders via `xcrun metal`, which ships only with full
           Xcode. Without this, builds fail with `unable to find utility "metal"`
           whenever `xcode-select -p` points at the Command Line Tools. The durable
           fix is system-wide: `sudo xcode-select -s /Applications/Xcode.app/Contents/Developer`. -->
      <env name="DEVELOPER_DIR" value="/Applications/Xcode.app/Contents/Developer" />
    </envs>
    <option name="emulateTerminal" value="true" />
    <option name="channel" value="DEFAULT" />
    <option name="requiredFeatures" value="true" />
    <option name="allFeatures" value="false" />
    <option name="withSudo" value="false" />
    <option name="buildTarget" value="LOCAL" />
    <option name="backtrace" value="SHORT" />
    <option name="isRedirectInput" value="false" />
    <option name="redirectInputPath" value="" />
    <method v="2">
      <option name="CARGO.BUILD_TASK_PROVIDER" enabled="true" />
    </method>
  </configuration>
</component>